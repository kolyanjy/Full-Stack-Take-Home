# === App ===
NODE_ENV=development
PORT=3000

# === Postgres (docker-compose) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=emissions
POSTGRES_USER=emissions
POSTGRES_PASSWORD=emissions

# Works for Prisma/Drizzle/pg:
DATABASE_URL=postgresql://emissions:emissions@localhost:5432/emissions

# === API / CORS ===
# Set to your frontend origin in production (comma-separate multiple origins)
CORS_ORIGIN=*
# URL the browser uses to reach the backend (baked into the frontend Docker image at build time)
VITE_API_URL=http://localhost:3001/v1

# === Redis (optional) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# === pgAdmin (optional, only if running with --profile tools) ===
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050