generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id                      String   @id @default(uuid())
  name                    String
  location                String
  emission_limit          Decimal  @db.Decimal(18, 6)
  total_emissions_to_date Decimal  @default(0) @db.Decimal(18, 6)
  metadata                Json?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  measurements  Measurement[]
  ingestBatches IngestBatch[]

  @@map("sites")
}

model IngestBatch {
  id           String   @id
  site_id      String
  total_value  Decimal  @db.Decimal(18, 6)
  count        Int
  processed_at DateTime @default(now())

  site         Site          @relation(fields: [site_id], references: [id])
  measurements Measurement[]

  @@map("ingest_batches")
}

model Measurement {
  id         String   @id @default(uuid())
  site_id    String
  batch_id   String
  value      Decimal  @db.Decimal(18, 6)
  unit       String   @default("kg")
  sensor_id  String?
  timestamp  DateTime
  created_at DateTime @default(now())

  site  Site        @relation(fields: [site_id], references: [id])
  batch IngestBatch @relation(fields: [batch_id], references: [id])

  @@index([site_id])
  @@index([site_id, timestamp])
  @@map("measurements")
}

model OutboxEvent {
  id           String    @id @default(uuid())
  event_type   String
  payload      Json
  processed    Boolean   @default(false)
  processed_at DateTime?
  attempts     Int       @default(0)
  last_error   String?
  created_at   DateTime  @default(now())

  @@index([processed, created_at])
  @@map("outbox_events")
}
